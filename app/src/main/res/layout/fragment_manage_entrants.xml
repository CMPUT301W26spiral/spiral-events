<?xml version="1.0" encoding="utf-8"?>
<!--
    fragment_manage_entrants.xml
    Layout for the Manage Entrants screen shown to organizers.
    Displays three tabs (Invited, Waiting, Cancelled) with a list of entrants in each.

    User Stories:
    - US 02.02.01: View list of entrants who joined the waiting list
    - US 02.06.01: View list of all chosen/invited entrants
    - US 02.06.02: View list of all cancelled entrants
-->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F0F7F0"
    android:padding="16dp">

    <!-- Top bar with back button and title -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="16dp">

        <!-- Back button to return to organizer event details -->
        <ImageButton
            android:id="@+id/backButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/ic_back"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Back" />

        <!-- Screen title -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Manage Entrants"
            android:textSize="22sp"
            android:textStyle="bold"
            android:layout_marginStart="8dp" />

    </LinearLayout>

    <!-- Shows how many people are on the waiting list -->
    <TextView
        android:id="@+id/waitingCountText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="0 People on Waiting List"
        android:textSize="14sp"
        android:layout_marginBottom="12dp" />

    <!-- Tab buttons for switching between Invited, Waiting, Cancelled -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="12dp">

        <!-- Invited tab button -->
        <Button
            android:id="@+id/btnInvited"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Invited"
            android:textSize="12sp"
            android:backgroundTint="#1B5E20"
            android:textColor="#FFFFFF"
            android:layout_marginEnd="4dp" />

        <!-- Waiting tab button -->
        <Button
            android:id="@+id/btnWaiting"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Waiting"
            android:textSize="12sp"
            android:backgroundTint="#FFFFFF"
            android:textColor="#1B5E20"
            android:layout_marginEnd="4dp" />

        <!-- Cancelled tab button -->
        <Button
            android:id="@+id/btnCancelled"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Cancelled"
            android:textSize="12sp"
            android:backgroundTint="#FFFFFF"
            android:textColor="#1B5E20" />

    </LinearLayout>

    <!-- RecyclerView for Invited entrants - visible when Invited tab is selected -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/invitedRecycler"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="visible" />

    <!-- RecyclerView for Waiting entrants - visible when Waiting tab is selected -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/waitingRecycler"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />

    <!-- RecyclerView for Cancelled entrants - visible when Cancelled tab is selected -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/cancelledRecycler"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />

</LinearLayout>