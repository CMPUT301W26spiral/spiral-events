<?xml version="1.0" encoding="utf-8"?>
<!--
    fragment_manage_entrants.xml
    Layout for the Manage Entrants screen shown to organizers.
    Displays three tabs (Invited, Waiting, Cancelled) with a list of entrants in each.

    User Stories:
    - US 02.02.01: View list of entrants who joined the waiting list
    - US 02.06.01: View list of all chosen/invited entrants
    - US 02.06.02: View list of all cancelled entrants
-->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F0F7F0">

    <!-- Top bar with back button and title -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="16dp">

        <ImageButton
            android:id="@+id/backButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/ic_back"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Back" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Manage Entrants"
            android:textSize="22sp"
            android:textStyle="bold"
            android:layout_marginStart="8dp" />

    </LinearLayout>

    <!-- Waiting count -->
    <TextView
        android:id="@+id/waitingCountText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="0 People on Waiting List"
        android:textSize="14sp"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:layout_marginBottom="12dp" />

    <!-- Tab buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:layout_marginBottom="8dp">

        <Button
            android:id="@+id/btnInvited"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:text="Invited"
            android:textSize="12sp"
            android:layout_marginEnd="4dp" />

        <Button
            android:id="@+id/btnWaiting"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:text="Waiting"
            android:textSize="12sp"
            android:layout_marginEnd="4dp" />

        <Button
            android:id="@+id/btnCancelled"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:text="Cancelled"
            android:textSize="12sp" />

    </LinearLayout>

    <!-- RecyclerViews - takes remaining space above buttons -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/invitedRecycler"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:visibility="gone" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/waitingRecycler"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:visibility="visible" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/cancelledRecycler"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:visibility="gone" />

    <!-- Bottom buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <Button
            android:id="@+id/btnDrawReplacement"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Draw Replacement Applicant"
            android:backgroundTint="#1B5E20"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="8dp" />

        <Button
            android:id="@+id/btnExportCsv"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Export CSV"
            android:backgroundTint="#1B5E20"
            android:textColor="#FFFFFF" />

    </LinearLayout>

</LinearLayout>