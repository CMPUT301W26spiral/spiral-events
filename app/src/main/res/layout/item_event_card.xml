<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="14dp"
    android:background="@drawable/bg_search"
    android:padding="12dp">

    <FrameLayout
        android:id="@+id/imageBox"
        android:layout_width="0dp"
        android:layout_height="140dp"
        android:background="#D9D9D9"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <TextView
        android:id="@+id/titleText"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Family Swimming Lessons"
        android:textStyle="bold"
        android:textSize="16sp"
        android:textColor="#1F1F1F"
        android:layout_marginTop="10dp"
        app:layout_constraintTop_toBottomOf="@id/imageBox"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/statusPill"/>

    <TextView
        android:id="@+id/statusPill"
        android:layout_width="wrap_content"
        android:layout_height="22dp"
        android:background="@drawable/bg_open_pill"
        android:paddingLeft="10dp"
        android:paddingRight="10dp"
        android:gravity="center"
        android:text="Open"
        android:textSize="12sp"
        android:textStyle="bold"
        android:textColor="#1F5E3B"
        app:layout_constraintTop_toTopOf="@id/titleText"
        app:layout_constraintEnd_toEndOf="parent"/>

    <ImageView
        android:id="@+id/iconCalendar"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:layout_marginTop="8dp"
        android:src="@drawable/ic_calendar"
        android:tint="#6B6B6B"
        app:layout_constraintTop_toBottomOf="@id/titleText"
        app:layout_constraintStart_toStartOf="parent"/>

    <TextView
        android:id="@+id/timeText"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:text="Sat, Mar. 4, 2026 10:00–11:00 AM"
        android:textColor="#444444"
        app:layout_constraintTop_toTopOf="@id/iconCalendar"
        app:layout_constraintStart_toEndOf="@id/iconCalendar"
        app:layout_constraintEnd_toEndOf="parent"/>

    <ImageView
        android:id="@+id/iconPlace"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:layout_marginTop="8dp"
        android:src="@drawable/ic_pin"
        android:tint="#6B6B6B"
        app:layout_constraintTop_toBottomOf="@id/iconCalendar"
        app:layout_constraintStart_toStartOf="parent"/>

    <TextView
        android:id="@+id/locationText"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:text="Peter Hemingway Aquatic Centre"
        android:textColor="#444444"
        app:layout_constraintTop_toTopOf="@id/iconPlace"
        app:layout_constraintStart_toEndOf="@id/iconPlace"
        app:layout_constraintEnd_toEndOf="parent"/>

    <ImageView
        android:id="@+id/iconPeople"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:layout_marginTop="8dp"
        android:src="@drawable/ic_people"
        android:tint="#6B6B6B"
        app:layout_constraintTop_toBottomOf="@id/iconPlace"
        app:layout_constraintStart_toStartOf="parent"/>

    <TextView
        android:id="@+id/waitingText"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:text="71 People on Waiting List"
        android:textColor="#444444"
        app:layout_constraintTop_toTopOf="@id/iconPeople"
        app:layout_constraintStart_toEndOf="@id/iconPeople"
        app:layout_constraintEnd_toStartOf="@+id/signUpButton"/>

    <Button
        android:id="@+id/signUpButton"
        android:layout_width="100dp"
        android:layout_height="40dp"
        android:text="Sign Up"
        android:textAllCaps="false"
        android:textStyle="bold"
        android:backgroundTint="#2E67C8"
        android:textColor="#FFFFFF"
        app:layout_constraintTop_toTopOf="@id/iconPeople"
        app:layout_constraintEnd_toEndOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>