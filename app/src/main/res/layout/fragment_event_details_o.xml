<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F2F9F2"
    android:padding="16dp"
    android:clickable="true"
    android:focusable="true">

    <ImageButton
        android:id="@+id/backButton"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="@android:color/transparent"
        android:src="@drawable/ic_back"
        android:contentDescription="Back"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>

    <TextView
        android:id="@+id/header"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Event Details"
        android:textStyle="bold"
        android:textSize="24sp"
        android:textColor="#000000"
        app:layout_constraintStart_toEndOf="@id/backButton"
        app:layout_constraintTop_toTopOf="@id/backButton"
        app:layout_constraintBottom_toBottomOf="@id/backButton"
        android:layout_marginStart="8dp"/>

    <androidx.cardview.widget.CardView
        android:id="@+id/imageCard"
        android:layout_width="0dp"
        android:layout_height="250dp"
        app:cardCornerRadius="0dp"
        app:cardElevation="0dp"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toBottomOf="@id/header"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#D9D9D9">

            <ImageView
                android:id="@+id/eventPosterImage"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop" />

            <ImageView
                android:id="@+id/editImageButton"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_gravity="bottom|end"
                android:layout_margin="12dp"
                android:src="@drawable/baseline_edit_24"
                android:background="@android:color/transparent"
                android:tint="#000000" />
        </FrameLayout>
    </androidx.cardview.widget.CardView>

    <TextView
        android:id="@+id/detailsTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Family Swimming Lessons"
        android:textStyle="bold"
        android:textSize="22sp"
        android:textColor="#000000"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toBottomOf="@id/imageCard"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <TextView
        android:id="@+id/detailsLocation"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Peter Hemingway Aquatic Centre"
        android:textSize="14sp"
        android:textColor="#000000"
        android:layout_marginTop="4dp"
        app:layout_constraintTop_toBottomOf="@id/detailsTitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <ImageView
        android:id="@+id/iconCalendar"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:layout_marginTop="12dp"
        android:src="@drawable/ic_calendar"
        android:tint="#2E673B"
        app:layout_constraintTop_toBottomOf="@id/detailsLocation"
        app:layout_constraintStart_toStartOf="parent"/>

    <TextView
        android:id="@+id/detailsTime"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:text="Sat, Mar. 4, 2026 10:00-11:00 AM"
        android:textColor="#000000"
        app:layout_constraintTop_toTopOf="@id/iconCalendar"
        app:layout_constraintBottom_toBottomOf="@id/iconCalendar"
        app:layout_constraintStart_toEndOf="@id/iconCalendar"
        app:layout_constraintEnd_toEndOf="parent"/>

    <ImageView
        android:id="@+id/iconPlace"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:layout_marginTop="8dp"
        android:src="@drawable/ic_pin"
        android:tint="#2E673B"
        app:layout_constraintTop_toBottomOf="@id/iconCalendar"
        app:layout_constraintStart_toStartOf="parent"/>

    <TextView
        android:id="@+id/detailsLocationAddress"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:text="Building 1, Peter Hemingway Aquatic Centre"
        android:textColor="#000000"
        app:layout_constraintTop_toTopOf="@id/iconPlace"
        app:layout_constraintBottom_toBottomOf="@id/iconPlace"
        app:layout_constraintStart_toEndOf="@id/iconPlace"
        app:layout_constraintEnd_toEndOf="parent"/>

    <ImageView
        android:id="@+id/iconPeople"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:layout_marginTop="8dp"
        android:src="@drawable/ic_people"
        android:tint="#2E673B"
        app:layout_constraintTop_toBottomOf="@id/iconPlace"
        app:layout_constraintStart_toStartOf="parent"/>

    <TextView
        android:id="@+id/detailsWaiting"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:text="71 People on Waiting List, 20 Open Spots"
        android:textColor="#000000"
        app:layout_constraintTop_toTopOf="@id/iconPeople"
        app:layout_constraintBottom_toBottomOf="@id/iconPeople"
        app:layout_constraintStart_toEndOf="@id/iconPeople"
        app:layout_constraintEnd_toEndOf="parent"/>

    <TextView
        android:id="@+id/descriptionLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Event Description"
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="#000000"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toBottomOf="@id/iconPeople"
        app:layout_constraintStart_toStartOf="parent"/>

    <TextView
        android:id="@+id/detailsDescription"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="No description available"
        android:textColor="#000000"
        app:layout_constraintTop_toBottomOf="@id/descriptionLabel"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <Button
        android:id="@+id/drawButton"
        android:layout_width="0dp"
        android:layout_height="50dp"
        android:text="Draw!"
        android:textStyle="bold"
        android:layout_marginTop="22dp"
        android:backgroundTint="#1F5E3B"
        android:textColor="#FFFFFF"
        app:layout_constraintTop_toBottomOf="@+id/detailsDescription"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <Button
        android:id="@+id/deleteEventButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="172dp"
        android:background="@drawable/profile_delete_button_bg"
        android:backgroundTint="@null"
        android:text="Delete Event"
        android:textColor="#FFFFFF"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.497"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/detailsDescription" />

    <Button
        android:id="@+id/viewEntrantsButton"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="View Entrants"
        android:textStyle="bold"
        android:layout_marginTop="22dp"
        android:backgroundTint="#1F5E3B"
        android:textColor="#FFFFFF"
        app:layout_constraintTop_toBottomOf="@+id/drawButton"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/notifyEntrantsButton"/>

    <Button
        android:id="@+id/notifyEntrantsButton"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Notify Entrants"
        android:textStyle="bold"
        android:layout_marginTop="22dp"
        android:backgroundTint="#1F5E3B"
        android:textColor="#FFFFFF"
        app:layout_constraintTop_toBottomOf="@+id/drawButton"
        app:layout_constraintStart_toEndOf="@+id/viewEntrantsButton"
        app:layout_constraintEnd_toStartOf="@+id/viewLocButton"/>

    <Button
        android:id="@+id/viewLocButton"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="View Locations"
        android:textStyle="bold"
        android:layout_marginTop="22dp"
        android:backgroundTint="#1F5E3B"
        android:textColor="#FFFFFF"
        app:layout_constraintTop_toBottomOf="@+id/drawButton"
        app:layout_constraintStart_toEndOf="@+id/notifyEntrantsButton"
        app:layout_constraintEnd_toEndOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>