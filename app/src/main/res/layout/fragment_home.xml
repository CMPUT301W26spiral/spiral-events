<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp"
    android:background="#F6F1F8">

    <LinearLayout
        android:id="@+id/locationRow"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Location:"
            android:textColor="#6B6B6B"
            android:textSize="12sp"/>

        <TextView
            android:id="@+id/locationText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Garneau, Edmonton, AB ▼"
            android:textStyle="bold"
            android:textSize="18sp"
            android:textColor="#1F1F1F"
            android:layout_marginTop="2dp"/>
    </LinearLayout>

    <View
        android:id="@+id/avatarCircle"
        android:layout_width="42dp"
        android:layout_height="42dp"
        android:background="@drawable/bg_chip_unselected"
        app:layout_constraintTop_toTopOf="@id/locationRow"
        app:layout_constraintEnd_toEndOf="parent"/>

    <LinearLayout
        android:id="@+id/searchRow"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="12dp"
        app:layout_constraintTop_toBottomOf="@id/locationRow"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:background="@drawable/bg_search"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:gravity="center_vertical">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/ic_search"
                android:tint="#6B6B6B"/>

            <EditText
                android:id="@+id/searchEditText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@android:color/transparent"
                android:hint="Search event"
                android:paddingStart="8dp"
                android:textSize="14sp"/>
        </LinearLayout>

        <ImageButton
            android:id="@+id/filterButton"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginStart="10dp"
            android:background="@drawable/bg_search"
            android:src="@drawable/ic_tune"
            android:tint="#1F1F1F"
            android:contentDescription="Filter"/>

        <Button
            android:id="@+id/scanButton"
            android:layout_width="90dp"
            android:layout_height="44dp"
            android:layout_marginStart="10dp"
            android:text="Scan"
            android:textAllCaps="false"
            android:textStyle="bold"
            android:textColor="#1F1F1F"
            android:background="@drawable/bg_search"
            app:icon="@drawable/ic_qr"
            app:iconPadding="6dp"/>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/chipRow"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="12dp"
        app:layout_constraintTop_toBottomOf="@id/searchRow"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/chipAll"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:background="@drawable/bg_chip_selected"
            android:paddingLeft="14dp"
            android:paddingRight="14dp"
            android:gravity="center"
            android:text="All"
            android:textColor="#FFFFFF"
            android:textStyle="bold"/>

        <TextView
            android:id="@+id/chipOpen"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:layout_marginStart="10dp"
            android:background="@drawable/bg_chip_unselected"
            android:paddingLeft="14dp"
            android:paddingRight="14dp"
            android:gravity="center"
            android:text="Open"
            android:textColor="#1F1F1F"
            android:textStyle="bold"/>

        <TextView
            android:id="@+id/chipWaiting"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:layout_marginStart="10dp"
            android:background="@drawable/bg_chip_unselected"
            android:paddingLeft="14dp"
            android:paddingRight="14dp"
            android:gravity="center"
            android:text="Waiting List"
            android:textColor="#1F1F1F"
            android:textStyle="bold"/>

        <TextView
            android:id="@+id/chipFull"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:layout_marginStart="10dp"
            android:background="@drawable/bg_chip_unselected"
            android:paddingLeft="14dp"
            android:paddingRight="14dp"
            android:gravity="center"
            android:text="Full"
            android:textColor="#1F1F1F"
            android:textStyle="bold"/>
    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/eventsRecyclerView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="14dp"
        app:layout_constraintTop_toBottomOf="@id/chipRow"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>