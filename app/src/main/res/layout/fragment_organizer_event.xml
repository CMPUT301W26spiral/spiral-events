<?xml version="1.0" encoding="utf-8"?>
<!--
    fragment_organizer_event.xml
    Layout for the Organizer Event Details screen.
    Shows event info and action buttons for the organizer to manage their event.

    User Stories:
    - US 02.02.01: View entrants on waiting list (View Entrants button)
    - US 02.06.01: View chosen entrants (View Entrants button)
    - US 02.03.01: Optionally limit number of entrants on waiting list
-->
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F0F7F0">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Top bar with back button and title -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="16dp">

            <!-- Back button -->
            <ImageButton
                android:id="@+id/backButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/ic_back"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Back" />

            <!-- Screen title -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Event Details"
                android:textSize="22sp"
                android:textStyle="bold"
                android:layout_marginStart="8dp" />

        </LinearLayout>

        <!-- Event poster placeholder -->
        <View
            android:layout_width="match_parent"
            android:layout_height="200dp"
            android:background="#CCCCCC"
            android:layout_marginBottom="16dp" />

        <!-- Event title -->
        <TextView
            android:id="@+id/organizerEventTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_marginBottom="4dp" />

        <!-- Event location -->
        <TextView
            android:id="@+id/organizerEventLocation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="14sp"
            android:layout_marginBottom="4dp" />

        <!-- Waiting count and open spots -->
        <TextView
            android:id="@+id/organizerEventWaiting"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="14sp"
            android:layout_marginBottom="8dp" />

        <!-- Event description -->
        <TextView
            android:id="@+id/organizerEventDescription"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="14sp"
            android:layout_marginBottom="16dp" />

        <!-- View Entrants button - navigates to ManageEntrantsFragment -->
        <Button
            android:id="@+id/btnViewEntrants"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="View Entrants"
            android:backgroundTint="#1B5E20"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="8dp" />

        <!-- Row with Notify Entrants and View Locations buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <!-- Notify Entrants button -->
            <Button
                android:id="@+id/btnNotifyEntrants"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Notify Entrants"
                android:backgroundTint="#1B5E20"
                android:textColor="#FFFFFF"
                android:layout_marginEnd="8dp" />

            <!-- View Locations button -->
            <Button
                android:id="@+id/btnViewLocations"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="View Locations"
                android:backgroundTint="#1B5E20"
                android:textColor="#FFFFFF" />

        </LinearLayout>

    </LinearLayout>

</ScrollView>