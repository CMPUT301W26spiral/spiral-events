<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="8dp">

    <ImageView
        android:id="@+id/imagePlaceholder"
        android:layout_width="0dp"
        android:layout_height="120dp"
        android:background="#D9D9D9"
        android:scaleType="centerCrop"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/eventTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="Family Swimming Lessons"
        android:textStyle="bold"
        android:textSize="16sp"
        android:textColor="#111111"
        app:layout_constraintTop_toBottomOf="@id/imagePlaceholder"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/statusChip" />

    <TextView
        android:id="@+id/statusChip"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingHorizontal="10dp"
        android:paddingVertical="4dp"
        android:text="X Days"
        android:textSize="11sp"
        android:textColor="#0F3D2E"
        android:background="#DDF0E3"
        app:layout_constraintBaseline_toBaselineOf="@id/eventTitle"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/eventTime"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="Sat, Mar. 4, 2026 10:00–11:00 AM"
        android:textSize="12sp"
        android:textColor="#333333"
        app:layout_constraintTop_toBottomOf="@id/eventTitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/detailsButton" />

    <TextView
        android:id="@+id/eventLocation"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Peter Hemingway Aquatic Centre"
        android:textSize="12sp"
        android:textColor="#333333"
        app:layout_constraintTop_toBottomOf="@id/eventTime"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/detailsButton" />

    <TextView
        android:id="@+id/eventWaiting"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="71 People on Waiting List"
        android:textSize="12sp"
        android:textColor="#333333"
        app:layout_constraintTop_toBottomOf="@id/eventLocation"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/detailsButton" />

    <TextView
        android:id="@+id/eventSubstatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:textSize="12sp"
        android:textStyle="bold"
        android:textColor="#0F3D2E"
        app:layout_constraintTop_toBottomOf="@id/eventWaiting"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintBottom_toBottomOf="parent" />

    <Button
        android:id="@+id/detailsButton"
        android:layout_width="90dp"
        android:layout_height="36dp"
        android:text="Details"
        android:textAllCaps="false"
        android:textColor="@android:color/white"
        android:backgroundTint="#1C6FD6"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>